<nav class="site-nav" aria-label="Primary">
  <div class="container nav-inner">
    <a href="/" class="logo" aria-label="SpectralEO home">
      <span class="logo-spectral">Spectral</span><span class="logo-eo">EO</span>
    </a>

    <ul class="nav-links">
      <li><a href="/#services">Services</a></li>
      <li><a href="/blog/">Blog</a></li>
      <li><a href="/#publications">Publications</a></li>
      <li><a href="/#contact" class="nav-cta">Get in Touch</a></li>
    </ul>

    <button
      class="menu-toggle"
      id="menuToggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="container mobile-menu" id="mobileMenu">
    <a href="/#services">Services</a>
    <a href="/blog/">Blog</a>
    <a href="/#publications">Publications</a>
    <a href="/#contact">Get in Touch</a>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileLinks = mobileMenu?.querySelectorAll('a') ?? [];

  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('open') ?? false;
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('open');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
